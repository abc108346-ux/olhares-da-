rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Critiques collection - public read for all visitors on mobile and desktop
    match /criticas/{criticaId} {
      allow read: if true;
      allow write: if true;
    }

    // Pages collection - public read
    match /paginas/{paginaId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (e.g. home settings, banner, manifesto)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // System configurations and media metadata
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if true;
    }

    // Sites Interessantes collection
    match /sites_interessantes/{siteId} {
      allow read: if true;
      allow write: if true;
    }

    // Prêmio Olhares da Cena collection
    match /premios_olhares/{premioId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback default
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

