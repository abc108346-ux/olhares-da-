{
  "entities": {
    "critica": {
      "title": "Crítica",
      "description": "Críticas e ensaios de artes cênicas",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "slug": { "type": "string" },
        "resumo": { "type": "string" },
        "conteudo": { "type": "string" },
        "autor": { "type": "string" },
        "categoria": { "type": "string" },
        "tags": { "type": "array" },
        "dataPublicacao": { "type": "string" },
        "dataAtualizacao": { "type": "string" },
        "imagemPrincipal": { "type": "string" },
        "publicada": { "type": "boolean" },
        "nomeEspetaculo": { "type": "string" }
      },
      "required": ["titulo", "slug", "resumo", "conteudo", "categoria", "dataPublicacao"]
    },
    "pagina": {
      "title": "Página",
      "description": "Páginas institucionais e editoriais",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "slug": { "type": "string" },
        "resumo": { "type": "string" },
        "conteudo": { "type": "string" },
        "publicada": { "type": "boolean" },
        "dataCriacao": { "type": "string" },
        "dataAtualizacao": { "type": "string" },
        "mostrarNoHeader": { "type": "boolean" },
        "mostrarNoFooter": { "type": "boolean" }
      },
      "required": ["titulo", "slug", "conteudo"]
    },
    "homeSettings": {
      "title": "Configurações da Página Inicial",
      "description": "Imagens e textos em destaque na página inicial",
      "type": "object",
      "properties": {
        "heroImageUrl": { "type": "string" },
        "manifestoText": { "type": "string" },
        "manifestoCaption": { "type": "string" }
      }
    },
    "siteStats": {
      "title": "Estatísticas do Site",
      "description": "Métricas globais e contador de visualizações do portal",
      "type": "object",
      "properties": {
        "totalViews": { "type": "number" },
        "lastViewAt": { "type": "string" }
      }
    },
    "siteInteressante": {
      "title": "Site Interessante",
      "description": "Referências e portais de artes cênicas recomendados",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "url": { "type": "string" },
        "descricao": { "type": "string" },
        "favicon": { "type": "string" },
        "ordem": { "type": "number" },
        "ativo": { "type": "boolean" },
        "criadoEm": { "type": "string" },
        "atualizadoEm": { "type": "string" }
      },
      "required": ["titulo", "url", "ativo"]
    },
    "premioOlhares": {
      "title": "Prêmio Olhares da Cena",
      "description": "Itens e links premiados do Prêmio Olhares da Cena",
      "type": "object",
      "properties": {
        "ordem": { "type": "number" },
        "titulo": { "type": "string" },
        "subtitulo": { "type": "string" },
        "link": { "type": "string" },
        "imagem": { "type": "string" },
        "descricao": { "type": "string" },
        "ativo": { "type": "boolean" },
        "atualizadoEm": { "type": "string" }
      },
      "required": ["ordem", "titulo", "link", "ativo"]
    }
  },
  "firestore": {
    "/criticas/{criticaId}": {
      "schema": { "$ref": "#/entities/critica" },
      "description": "Coleção de artigos de críticas de artes cênicas"
    },
    "/paginas/{paginaId}": {
      "schema": { "$ref": "#/entities/pagina" },
      "description": "Coleção de páginas institucionais"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/siteStats" },
      "description": "Configurações e estatísticas do site"
    },
    "/sites_interessantes/{siteId}": {
      "schema": { "$ref": "#/entities/siteInteressante" },
      "description": "Coleção de links e sites interessantes"
    },
    "/premios_olhares/{premioId}": {
      "schema": { "$ref": "#/entities/premioOlhares" },
      "description": "Coleção dos 15 espaços e links do Prêmio Olhares da Cena"
    }
  }
}
